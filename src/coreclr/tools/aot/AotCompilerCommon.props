<Project>
  <PropertyGroup>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <TieredCompilation>false</TieredCompilation>
    <EventSourceSupport>true</EventSourceSupport>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ControlFlowGuard>Guard</ControlFlowGuard>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols Condition="'$(KeepNativeSymbols)' == 'true'">false</StripSymbols>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Сравнение шло со строкой 'true', а CrossHostArch — это имя архитектуры
      ($(BuildArchitecture)) или пустота. Строкой 'true' она не бывает, поэтому
      первая ветка была мертва и всегда брался ХОСТОВОЙ набор имён.
      По смыслу наоборот: CrossHostArch задана у вариантов _inbuild, которые
      исполняются на машине сборки, — им нужен хостовой набор; пуста она у
      _publish, у которых RID целевой, — им нужен целевой. Пока хост совпадает
      с целью, оба набора одинаковы и ошибки не видно; при сборке win-x64 с
      macOS _publish искал libjitinterface_x64.dylib вместо лежащего рядом
      jitinterface_x64.dll.
    -->
    <_LibPrefix Condition="'$(CrossHostArch)' == ''">$(LibPrefix)</_LibPrefix>
    <_LibPrefix Condition="'$(CrossHostArch)' != ''">$(HostLibPrefix)</_LibPrefix>
    <_LibSuffix Condition="'$(CrossHostArch)' == ''">$(LibSuffix)</_LibSuffix>
    <_LibSuffix Condition="'$(CrossHostArch)' != ''">$(HostLibSuffix)</_LibSuffix>
  </PropertyGroup>
</Project>
